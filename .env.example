# ========================================
# EnvSafe Storage Agent - Configuration
# ========================================

# SECRET PARTAGÉ (OBLIGATOIRE)
# Utilisez un générateur de mots de passe sécurisé
# Ce secret doit être identique à celui configuré dans EnvSafe (SaaS)
# Générez avec: openssl rand -hex 32
AUTH_SECRET=your-very-long-and-secure-secret-here-replace-me

# PORT D'ÉCOUTE
PORT=3001

# BASE DE DONNÉES
# PostgreSQL (Recommandé pour la production)
DATABASE_URL=postgresql://user:password@localhost:5432/envsafe_storage

# SQLite (Pour les tests uniquement)
# DATABASE_URL=file:./envsafe-storage.db

# NODE_ENV
NODE_ENV=production
